.env
__pycache__/
*.pyc
.venv/
venv/
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.log
.DS_Store
docker/postgres_data/
mlruns/

# Dissertation drafts: intentionally never pushed to GitHub (avoid a public
# copy creating a similarity-checker false positive against the student's
# own submission).
dissertation/

# Reference geography: the OCHA boundary files are large public downloads,
# reproducible from data.humdata.org, so they are fetched rather than versioned.
# The LGA crosswalk is excluded for a different reason: it carries per-LGA record
# counts derived from the Bulwark Intelligence data, which is licensed for this
# research but not for publication on a public repository.
data/reference/*
!data/reference/.gitkeep

# Shiny app data: generated from the Bulwark Intelligence corpus and carrying
# incident narratives, locations, casualty counts and perpetrator attribution.
# Same licensing position as data/reference above, so the app code is versioned
# and the data it reads is regenerated by scripts/build_app_data.py.
app/data/*
!app/data/.gitkeep
